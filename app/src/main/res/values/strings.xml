<!-- The car is Russian-speaking and so is the driver: one language, no translations. -->
<resources>
    <string name="app_name">Куда поехать</string>
    <string name="intro">Когда машина заводится, на приборке появляется «Куда едем?»: события календаря, места, куда вы обычно ездите в это время, дом или работа. Колёсико громкости — выбрать, ⏯ — построить маршрут в Навигаторе. Поездки запоминаются сами и остаются в машине.</string>

    <string name="card_title">Куда едем?</string>
    <string name="not_now">Не сейчас</string>
    <string name="nothing_title">Пока нечего предложить</string>
    <string name="nothing_text">Поездите несколько дней или войдите в Яндекс</string>

    <string name="channel_name">Запись поездок</string>
    <string name="service_text">Запоминает поездки, предлагает маршрут при запуске</string>

    <string name="suggest_now">Предложить сейчас</string>
    <string name="grant_location">Разрешить геопозицию</string>
    <string name="grant_navi">Доступ к уведомлениям Навигатора</string>
    <string name="grant_navi_failed">На этой магнитоле нет экрана доступа к уведомлениям</string>
    <string name="navi_hint">Необязательно. Тогда приложение видит, что Навигатор уже ведёт по маршруту, и не спрашивает зря. В Навигаторе должна быть включена «Фоновая навигация».</string>
    <string name="clear_trips">Забыть все поездки</string>
    <string name="clear_trips_q">Удалить всю историю поездок? Предложения начнут учиться заново.</string>
    <string name="clear">Удалить</string>
    <string name="cancel">Отмена</string>

    <string name="st_notify_ok">Всплывашки на приборке: Car Notification Service</string>
    <string name="st_notify_missing">Нет Car Notification Service — предложения откроются на экране магнитолы</string>
    <string name="st_navi_ok">Яндекс Навигатор найден</string>
    <string name="st_navi_missing">Яндекс Навигатор не найден — маршрут откроется в Картах</string>
    <string name="st_location_ok">Поездки записываются: %1$d</string>
    <string name="st_location_missing">Нет доступа к геопозиции — поездки не записываются</string>
    <string name="st_yandex_ok">Яндекс: закладок %1$d, Дом %2$s, Работа %3$s (обновлено %4$s)</string>
    <string name="st_yandex_missing">Яндекс не подключён — Дом и Работа узнаются по поездкам</string>
    <string name="cal_section">Календари</string>
    <string name="cal_none">Не подключены. Тогда события в ближайший час не предлагаются.</string>
    <string name="cal_add">Добавить календарь</string>
    <string name="cal_add_title">Какой календарь подключить?</string>
    <string name="cal_add_hint">Вход по логину и паролю. Пароль хранится только в машине, зашифрованным. Из календаря берутся события, которые идут сейчас или начнутся в течение часа, и их место.</string>
    <string name="cal_google">Google Календарь по паролю подключить нельзя: Google пускает только через свой вход (OAuth). Можно добавить его в iCloud или Яндекс Календарь на телефоне и подключить тот.</string>
    <string name="cal_server">Адрес сервера CalDAV (https://…)</string>
    <string name="cal_server_optional">Адрес почты на работе — если не найдётся сам (необязательно)</string>
    <string name="cal_password">Пароль</string>
    <string name="cal_app_password">Пароль приложения</string>
    <string name="cal_connect">Подключить</string>
    <string name="cal_connecting">Вхожу и ищу календари…</string>
    <string name="cal_fill_in">Заполните все поля</string>
    <string name="cal_wrong_password">Неверный логин или пароль</string>
    <string name="cal_wrong_app_password">Неверный логин или пароль. Нужен пароль приложения, а не обычный пароль — см. подсказку выше.</string>
    <string name="cal_failed">Не получилось: %1$s</string>
    <string name="cal_choose">Какие календари смотреть?</string>
    <string name="cal_none_chosen">Отметьте хотя бы один календарь</string>
    <string name="cal_save">Сохранить</string>
    <string name="cal_remove_q">Отключить %1$s?</string>
    <string name="cal_remove">Отключить</string>
    <string name="back">Назад</string>
    <plurals name="cal_count">
        <item quantity="one">%d календарь</item>
        <item quantity="few">%d календаря</item>
        <item quantity="many">%d календарей</item>
        <item quantity="other">%d календаря</item>
    </plurals>
    <string name="st_listener_ok">Видно, когда Навигатор ведёт по маршруту</string>
    <string name="st_listener_missing">Нет доступа к уведомлениям Навигатора (необязательно)</string>

    <string name="yandex_login">Войти в Яндекс</string>
    <string name="yandex_sync">Обновить закладки Яндекса</string>
    <string name="yandex_logout">Выйти из Яндекса</string>
    <string name="login_title">Вход в Яндекс</string>
    <string name="login_hint">Наведите камеру телефона на код, откройте ссылку и подтвердите вход в приложении Яндекс. Пароль не нужен.</string>
    <string name="login_starting">Готовлю вход…</string>
    <string name="login_failed">Не получилось начать вход: %1$s</string>
    <string name="login_timeout">Вход не подтвердили за 5 минут — попробуйте ещё раз</string>
</resources>
